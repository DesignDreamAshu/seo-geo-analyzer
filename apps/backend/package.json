{
  "name": "@seo-geo/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "render-build": "npx playwright install --with-deps chromium && tsc -p tsconfig.json",
    "postinstall": "npx playwright install chromium || true",
    "verify:release": "tsx src/crawler/verification/release-orchestrator.ts",
    "verify:local-accuracy": "tsx src/crawler/verification/local-accuracy-orchestrator.ts",
    "verify:deployed": "tsx src/crawler/verification/verify-deployed-service.ts",
    "test:security:s1": "tsx src/crawler/security/__tests__/run-security-s1-tests.ts",
    "test:security:s2": "tsx src/crawler/security/__tests__/run-security-s2-tests.ts",
    "test:security:s3": "tsx src/crawler/security/__tests__/run-security-s3-certification.ts",
    "test:security:s4": "tsx src/crawler/security/__tests__/run-security-s4-remediation-tests.ts",
    "test:security:s5": "tsx src/crawler/security/__tests__/run-security-s5-score-tests.ts",
    "test:security:s6": "tsx src/crawler/security/__tests__/run-security-s6-tests.ts",
    "test:security:s7": "tsx src/crawler/security/__tests__/run-security-s7-tests.ts",
    "test:security": "tsx src/crawler/security/__tests__/run-all-security-tests.ts",
    "test:security:all-raw": "tsx src/crawler/security/__tests__/run-security-s1-tests.ts && tsx src/crawler/security/__tests__/run-security-s2-tests.ts && tsx src/crawler/security/__tests__/run-security-s3-certification.ts && tsx src/crawler/security/__tests__/run-security-s4-remediation-tests.ts && tsx src/crawler/security/__tests__/run-security-s5-score-tests.ts && tsx src/crawler/security/__tests__/run-security-s6-tests.ts && tsx src/crawler/security/__tests__/run-security-s7-tests.ts",
    "test:providers:unit": "tsx src/ai-search/__tests__/run-openrouter-unit-tests.ts",
    "test:ai:report": "tsx src/ai-search/__tests__/run-ai-report-integration-tests.ts",
    "certify:providers:live": "tsx src/ai-search/__tests__/run-live-provider-certification.ts",
    "start": "node index.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "detect-port": "^2.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fast-xml-parser": "^4.5.0",
    "fs-extra": "^11.2.0",
    "got": "^14.4.2",
    "html-pdf-node": "^1.0.8",
    "lighthouse": "^12.8.2",
    "linkedom": "^0.18.5",
    "nanoid": "^5.0.7",
    "playwright": "^1.62.1",
    "structured-data-testing-tool": "^4.5.0",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/fs-extra": "^11.0.4",
    "typescript": "^5.8.3"
  }
}
