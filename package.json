{
  "name": "seo-geo-analyzer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace root for the SEO & GEO Analyzer monorepo",
  "workspaces": [
    "apps/backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch apps/backend/src/index.ts",
    "build": "npm --workspace apps/backend run build",
    "verify:release": "npm --workspace apps/backend run verify:release",
    "start": "node apps/backend/dist/index.js"
  },
  "devDependencies": {
    "tsx": "^4.19.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DesignDreamAshu/seo-geo-analyzer.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DesignDreamAshu/seo-geo-analyzer/issues"
  },
  "homepage": "https://github.com/DesignDreamAshu/seo-geo-analyzer#readme"
}
